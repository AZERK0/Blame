# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=replace-with-at-least-32-random-characters
APP_KEY_PREVIOUS=
ACCOUNT_CLOSURE_LEDGER_DIRECTORY=/var/lib/blame/account-closure-ledger
APP_URL=http://${HOST}:${PORT}

BETTER_AUTH_URL=http://${HOST}:${PORT}
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_TRUSTED_ORIGINS=http://${HOST}:${PORT},http://localhost:5173
BLAME_SITE_URL=https://blame.so

# Mail
AUTH_EMAIL_FROM=Blame <auth@blame.so>
RESEND_API_KEY=

# OAuth client
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Telemetry
BLAME_TELEMETRY_MAX_PAYLOAD_BYTES=4194304
BLAME_TELEMETRY_PUBLIC_ENDPOINT=http://${HOST}:${PORT}/api/v1/telemetry/otlp
BLAME_TELEMETRY_REQUESTS_PER_MINUTE=120
BLAME_TELEMETRY_TOKEN_SECRET=replace-with-at-least-32-random-characters
BLAME_TELEMETRY_TOKEN_TTL_SECONDS=900
BLAME_TELEMETRY_UPSTREAM_ENDPOINT=http://127.0.0.1:4318
BLAME_TELEMETRY_UPSTREAM_HEADERS=
BLAME_TELEMETRY_UPSTREAM_TIMEOUT_MS=10000

# Attachments
ATTACHMENTS_STORAGE_DRIVER=s3
ATTACHMENTS_MAX_BYTES=10485760
ATTACHMENTS_DOWNLOAD_URL_TTL_SECONDS=900
ATTACHMENTS_UPLOAD_URL_TTL_SECONDS=900
ATTACHMENTS_ORPHAN_GRACE_HOURS=24
ATTACHMENTS_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
ATTACHMENTS_S3_REGION=gra
ATTACHMENTS_S3_BUCKET=blame-prod-attachments-gra
ATTACHMENTS_S3_ACCESS_KEY_ID=
ATTACHMENTS_S3_SECRET_ACCESS_KEY=
ATTACHMENTS_S3_FORCE_PATH_STYLE=false

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=

# Session
SESSION_DRIVER=cookie

# Stripe Billing (use test keys locally; never commit real secrets)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_MONTHLY_PRICE_ID=price_replace_monthly
STRIPE_YEARLY_PRICE_ID=price_replace_yearly
STRIPE_CHECKOUT_SUCCESS_URL=https://blame.so/billing/success
STRIPE_CHECKOUT_CANCEL_URL=https://blame.so/billing/cancelled
STRIPE_PORTAL_RETURN_URL=https://blame.so/billing/portal-return

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
