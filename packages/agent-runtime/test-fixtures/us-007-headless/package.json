{
  "name": "blame-us-007-headless",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "prisma validate --schema prisma/schema.prisma && tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:json": "node scripts/validate-json.mjs",
    "validate:prisma": "prisma validate --schema prisma/schema.prisma"
  },
  "devDependencies": {
    "jsonc-parser": "3.3.1",
    "prisma": "6.19.0",
    "typescript": "5.9.3"
  }
}
