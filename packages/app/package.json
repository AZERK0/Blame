{
  "name": "@blame/app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.tsx"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "default": "./vite.js"
    },
    "./index.css": "./src/index.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "node --test --experimental-strip-types src/components/backlog/data/agent-flow.test.ts src/components/backlog/data/backlog-store-merge.test.ts src/components/backlog/data/user-story-context.test.ts src/components/backlog/development/development-diff-parser.test.ts src/components/backlog/drawer/markdown-preview-parser.test.ts src/components/backlog/drawer/user-story-activity-tree.test.ts src/components/new-project/new-project-options.test.ts src/components/new-project/new-project-host-dependencies.test.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@blame/agent-runtime": "workspace:*",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/nunito-sans": "5.2.7",
    "@fontsource-variable/source-sans-3": "5.2.9",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "ghostty-web": "github:anomalyco/ghostty-web#main",
    "lucide-react": "1.14.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "3.8.0",
    "shadcn": "4.6.0",
    "shiki": "catalog:",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.3.1"
  }
}
