[Unit]
Description=Create an encrypted Blame MySQL backup
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/blame/retention.env
ExecStart=/usr/local/sbin/blame-backup-mysql
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=-/etc/blame/backup.key
ReadWritePaths=-/var/backups/blame
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
UMask=0077
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2h
