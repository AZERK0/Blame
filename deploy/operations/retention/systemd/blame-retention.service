[Unit]
Description=Run Blame account and server-log retention
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/blame/retention.env
ExecStart=/usr/local/sbin/blame-run-retention
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=-/etc/dokploy/logs -/etc/dokploy/schedules -/etc/dokploy/volume-backups -/etc/dokploy/traefik/dynamic -/var/lib/blame/account-closure-ledger
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
UMask=0077
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
