{
  "name": "blame",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:linux": "node scripts/desktop-release.mjs build --linux AppImage --x64",
    "build:macos": "node scripts/desktop-release.mjs build --mac --x64 --arm64",
    "build:runtime": "node scripts/runtime-release.mjs build",
    "build:runtime:all": "node scripts/runtime-release.mjs build --all-architectures",
    "build:runtime:macos": "node scripts/runtime-release.mjs build --platform macos",
    "build:runtime:windows": "node scripts/runtime-release.mjs build --platform windows",
    "build:sandbox-runner": "node scripts/sandbox-runner-release.mjs build",
    "build:macos-runtime": "node scripts/macos-runtime-image.mjs build",
    "build:windows-runtime": "node scripts/windows-runtime-rootfs.mjs build",
    "build:windows": "node scripts/desktop-release.mjs build --win --x64",
    "deploy:desktop": "node scripts/desktop-release.mjs deploy",
    "deploy:runtime": "node scripts/runtime-release.mjs deploy",
    "deploy:macos-runtime": "node scripts/macos-runtime-image.mjs deploy",
    "deploy:windows-runtime": "node scripts/windows-runtime-rootfs.mjs deploy",
    "dev": "node scripts/dev-with-database-tunnel.mjs",
    "dev:vitrine": "pnpm --filter @blame/vitrine dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "release:linux": "node scripts/desktop-release.mjs release --linux AppImage --x64",
    "release:macos": "node scripts/desktop-release.mjs release --mac --x64 --arm64",
    "release:runtime": "node scripts/runtime-release.mjs release --all-architectures",
    "release:sandbox-runner": "node scripts/sandbox-runner-release.mjs release",
    "release:macos-runtime": "node scripts/macos-runtime-image.mjs release",
    "release:windows-runtime": "node scripts/windows-runtime-rootfs.mjs release",
    "release:windows": "node scripts/desktop-release.mjs release --win --x64",
    "sync:runtime-sdk": "node scripts/runtime-sdk-version.mjs",
    "test:download-storage": "node --test scripts/download-object-storage.test.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify:runtime:macos": "node scripts/macos-runtime-image.mjs verify",
    "check:line-budgets": "node scripts/check-line-budgets.mjs",
    "licenses:extract": "node scripts/extract-open-source-projects.mjs",
    "benchmark:preview-runtime": "node --experimental-strip-types scripts/benchmark-preview-runtime.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "prettier": "^3.7.4",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "ai": "6.0.197"
    }
  }
}
