{
  "type": "function",
  "name": "edit_code",
  "strict": false,
  "parameters": {
    "type": "object",
    "properties": {
      "operations": {
        "minItems": 1,
        "maxItems": 50,
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "symbol"
                },
                "target": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "action": {
                  "type": "string",
                  "enum": [
                    "replace",
                    "replace_body",
                    "insert_before",
                    "insert_after",
                    "delete"
                  ]
                },
                "content": {
                  "type": "string",
                  "maxLength": 2097152
                }
              },
              "required": [
                "kind",
                "target",
                "action"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "patch"
                },
                "target": {
                  "description": "Observed symbol alias. Restricts one Update File patch to this symbol; its header must match the alias path.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "path": {
                  "description": "Target for raw content or a patch without file headers. Explicit patch headers select their own files.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "patch": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2097152,
                  "description": "For an existing file: *** Begin Patch\n*** Update File: file.ts\n@@\n-old line\n+new line\n*** End Patch. For a new path, complete raw content is also accepted."
                }
              },
              "required": [
                "kind",
                "patch"
              ],
              "additionalProperties": false
            }
          ]
        }
      }
    },
    "required": [
      "operations"
    ],
    "additionalProperties": false
  }
}
