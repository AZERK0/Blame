        [
          "node <<'NODE'\nfunction normalizeStorageKey(value) {\n  if (typeof value !== \"string\" || value.length === 0) return null;\n  let decoded;\n  try { decoded = decodeURIComponent(value); } catch { return null; }\n  while (/%[0-9a-f]{2}/i.test(decoded)) {\n    try { decoded = decodeURIComponent(decoded); } catch { return null; }\n  }\n  const path = decoded.replaceAll(\"\\\\\", \"/\");\n  if (path.startsWith(\"/\") || /^[a-z]:($|\\/)/i.test(path)) return null;\n  const segments = path.split(\"/\");\n  if (segments.some((segment) => segment === \"..\")) return null;\n  const normalized = segments.filter((segment) => segment !== \"\" && segment !== \".\").join(\"/\");\n  return normalized || null;\n}\nconst cases = {\n  \"projects//2026/./hero.jpg\": \"projects/2026/hero.jpg\",\n  \"\": null,\n  \"/projects/file\": null,\n  \"..\": null,\n  \"projects/../file\": null,\n  \"projects\\\\..\\\\file\": null,\n  \"projects/%2e%2e/file\": null,\n  \"projects/%252e%252e%255cfile\": null,\n  \"%E0%A4%A\": null,\n  \"projects/2026/hero.jpg\": \"projects/2026/hero.jpg\",\n};\nfor (const [input, expected] of Object.entries(cases)) {\n  const actual = normalizeStorageKey(input);\n  if (actual !== expected) throw new Error(`${input}: expected ${expected}, got ${actual}`);\n}\nconsole.log(`Validated ${Object.keys(cases).length} normalization cases.`);\nNODE"
        ]
