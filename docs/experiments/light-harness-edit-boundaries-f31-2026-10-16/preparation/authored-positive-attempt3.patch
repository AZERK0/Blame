diff --git a/src/readers/reader.ts b/src/readers/reader.ts
index a06be6a..1fbdee5 100644
--- a/src/readers/reader.ts
+++ b/src/readers/reader.ts
@@ -19,6 +19,20 @@ export default abstract class Reader<T> {
 	public abstract dynamic(root: string, options: ReaderOptions): T;
 	public abstract static(patterns: Pattern[], options: ReaderOptions): T;
 
+	protected _guardFilterErrors(options: ReaderOptions, onError: (error: unknown) => void): ReaderOptions {
+		if (!this._settings.filter) return options;
+		let failed = false;
+		const guard = (filter: ReaderOptions['entryFilter'] | undefined) => (entry: Entry): boolean => {
+			if (failed) return false;
+			try { return !filter || filter(entry); } catch (error) {
+				failed = true;
+				onError(error);
+				return false;
+			}
+		};
+		return { ...options, entryFilter: guard(options.entryFilter), deepFilter: guard(options.deepFilter) };
+	}
+
 	protected _getFullEntryPath(filepath: string): string {
 		return path.resolve(this._settings.cwd, filepath);
 	}
