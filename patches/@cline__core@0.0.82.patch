--- /dev/null
+++ b/dist/image-token-estimation.js
@@ -0,0 +1,47 @@
+export function createImageTokenEstimator(imageTokenLimit) {
+    const cached = new WeakMap();
+    return (value) => {
+        if (cached.has(value)) return cached.get(value);
+        const result = estimateImageTokens(value, imageTokenLimit);
+        cached.set(value, result);
+        return result;
+    };
+}
+
+function estimateImageTokens(value, imageTokenLimit) {
+    const images = new WeakSet();
+    for (const message of value.messages ?? [value]) collectMessageImages(message, images);
+    const ancestors = [];
+    let imageTokens = 0;
+    const serialized = JSON.stringify(value, function (key, item) {
+        if (!item || typeof item !== "object") return item;
+        if (images.has(item)) {
+            imageTokens += imageTokenLimit;
+            return { ...item, data: "" };
+        }
+        while (ancestors.length && ancestors.at(-1) !== this) ancestors.pop();
+        if (ancestors.includes(item)) return "[Circular]";
+        ancestors.push(item);
+        return item;
+    });
+    return Math.max(1, Math.ceil(serialized.length / 3)) + imageTokens;
+}
+
+function collectMessageImages(message, images) {
+    if (!Array.isArray(message.content)) return;
+    for (const block of message.content) {
+        if (block.type === "image") collectOutputImages(block, images);
+        else if (block.type === "tool_result") collectOutputImages(block.content, images);
+    }
+}
+
+function collectOutputImages(value, images, visited = new WeakSet()) {
+    if (!value || typeof value !== "object") return;
+    if (visited.has(value)) return;
+    visited.add(value);
+    if (value.type === "image" && typeof value.data === "string" && typeof value.mediaType === "string") {
+        images.add(value);
+        return;
+    }
+    for (const child of Object.values(value)) collectOutputImages(child, images, visited);
+}
